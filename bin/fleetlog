#!/usr/bin/env python3
"""The fleetlog command; through its git-fleetlog link, git runs it as
`git fleetlog` too.

Kept to syntax old Pythons can parse, so the version check below runs and
prints one line instead of a traceback.
"""
import os
import sys

if sys.version_info < (3, 11):
    sys.stderr.write(
        "fleetlog: needs Python 3.11 or newer, this is %d.%d\n"
        % tuple(sys.version_info[:2])
    )
    sys.exit(2)

# Resolve symlinks so a link in ~/.local/bin still finds the package.
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from fleetlog.cli import main  # noqa: E402

sys.exit(main())
