#!/usr/bin/env bash
# A fake ssh for tests. It records its arguments, one file per call under
# $FL_FAKE/calls, then runs the remote command here, as real ssh would on the
# far side, with HOME set to the machine's fixture home, $FL_FAKE/homes/<target>.
# A target with no fixture home is unreachable.
set -uo pipefail

fake=${FL_FAKE:?fake ssh: FL_FAKE is not set}
call=$(mktemp "$fake/calls/ssh.XXXXXX") || exit 255
printf '%s\0' "$@" >"$call"

while (($#)) && [[ $1 != -- ]]; do
  shift
done
if (($# < 2)); then
  echo "fake ssh: no -- followed by a target" >&2
  exit 255
fi
target=$2
shift 2

home=$fake/homes/$target
if [[ ! -d $home ]]; then
  echo "ssh: connect to host $target port 22: No route to host" >&2
  exit 255
fi
cd "$home" || exit 255
unset XDG_CONFIG_HOME XDG_STATE_HOME XDG_DATA_HOME XDG_CACHE_HOME
HOME=$home exec bash -c "$*"
